// ═══════════════════════════════════════════════════════════════
// TEZZ-OS — Programmable Interval Timer 8253/8254 (kernel/pit.tn)
// ═══════════════════════════════════════════════════════════════

import "sys"

let PIT_CMD:int       = 0x43
let PIT_DATA0:int     = 0x40
let PIT_BASE_FREQ:int = 1193182

static let g_ticks:int = 0
static let g_hz:int    = 1000

fn init(freq_hz:int) -> int:
  g_hz = freq_hz
  divisor:int = PIT_BASE_FREQ / freq_hz
  // Channel 0, Access mode: lobyte/hibyte, Mode 3 (Square wave generator), Binary
  sys.sys_outb(PIT_CMD, 0x36)
  sys.sys_outb(PIT_DATA0, divisor & 0xFF)
  sys.sys_outb(PIT_DATA0, (divisor >> 8) & 0xFF)
  ret 0

fn tick() -> int:
  g_ticks = g_ticks + 1
  ret 0

fn ticks() -> int:
  ret g_ticks

fn ms() -> int:
  if g_hz == 0: ret 0
  ret (g_ticks * 1000) / g_hz

fn sleep_ms(target_ms:int) -> int:
  start:int = ms()
  while (ms() - start) < target_ms:
    1
  ret 0
