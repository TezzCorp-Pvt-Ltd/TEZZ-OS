// ═══════════════════════════════════════════════════════════════
// TEZZ-OS — 8259A PIC Controller (kernel/pic.tn)
// ═══════════════════════════════════════════════════════════════

import "sys"

let PIC1_CMD:int  = 0x20
let PIC1_DATA:int = 0x21
let PIC2_CMD:int  = 0xA0
let PIC2_DATA:int = 0xA1
let PIC_EOI:int   = 0x20

fn init() -> int:
  // Mask all IRQs initially
  sys.sys_outb(PIC1_DATA, 0xFF)
  sys.sys_outb(PIC2_DATA, 0xFF)
  ret 0

fn remap(offset1:int, offset2:int) -> int:
  // ICW1: initialization sequence
  sys.sys_outb(PIC1_CMD, 0x11)
  sys.sys_outb(PIC2_CMD, 0x11)
  // ICW2: master/slave vector offsets
  sys.sys_outb(PIC1_DATA, offset1)
  sys.sys_outb(PIC2_DATA, offset2)
  // ICW3: tell master that slave is at IRQ2 (0000 0100)
  sys.sys_outb(PIC1_DATA, 4)
  // ICW3: tell slave its cascade identity (0000 0010)
  sys.sys_outb(PIC2_DATA, 2)
  // ICW4: 8086/88 (MCS-80/85) mode
  sys.sys_outb(PIC1_DATA, 1)
  sys.sys_outb(PIC2_DATA, 1)
  // Mask all IRQs initially
  sys.sys_outb(PIC1_DATA, 0xFF)
  sys.sys_outb(PIC2_DATA, 0xFF)
  ret 0

fn enable_irq(irq:int) -> int:
  port:int = PIC1_DATA
  line:int = irq
  if irq >= 8:
    port = PIC2_DATA
    line = irq - 8
  val:int = sys.sys_inb(port)
  sys.sys_outb(port, val & (0xFF ^ (1 << line)))
  ret 0

fn disable_irq(irq:int) -> int:
  port:int = PIC1_DATA
  line:int = irq
  if irq >= 8:
    port = PIC2_DATA
    line = irq - 8
  val:int = sys.sys_inb(port)
  sys.sys_outb(port, val | (1 << line))
  ret 0

fn eoi(irq:int) -> int:
  if irq >= 8:
    sys.sys_outb(PIC2_CMD, PIC_EOI)
  sys.sys_outb(PIC1_CMD, PIC_EOI)
  ret 0
