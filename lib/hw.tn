  vga.print("Bluetooth Wireless Controller Subsystem (hci0):\n")
  vga.print("──────────────────────────────────────────────────────────────────────────────\n")

  vga.set_color(15, 0)
  vga.print("  Interface:       ")
  vga.set_color(10, 0)
  vga.print("hci0\n")

  vga.set_color(15, 0)
  vga.print("  Hardware:        ")
  vga.set_color(14, 0)
  vga.print(wireless.bt_get_hardware())
  vga.print("\n")

  vga.set_color(15, 0)
  vga.print("  Version:         ")
  vga.set_color(10, 0)
  vga.print(wireless.bt_get_version())
  vga.print("\n")

  vga.set_color(15, 0)
  vga.print("  BD Address:      ")
  vga.set_color(10, 0)
  vga.print(wireless.bt_get_mac())
  vga.print("\n")

  vga.set_color(15, 0)
  vga.print("  Status:          ")
  vga.set_color(10, 0)
  vga.print("ENABLED (Discoverable, Pairing Ready)\n")

  vga.set_color(11, 0)
  vga.print("\nDiscovered & Paired Peripherals:\n")
  vga.set_color(7, 0)
  vga.print("  [✓] TEZZ Precision Wireless Mouse  [70:B3:D5:12:34:56] (HID, RSSI: -48 dBm) [CONNECTED]\n")
  vga.print("  [✓] TEZZ Audio Pods Pro            [AC:DE:48:88:99:AA] (A2DP Audio, RSSI: -55 dBm)\n")
  vga.print("  [ ] TEZZ Mechanical Keyboard       [5C:E9:1E:AA:BB:CC] (HID, RSSI: -62 dBm)\n")

  vga.set_color(7, 0)
  ret 0

fn print_hwinfo() -> int:
  vga.set_color(11, 0)
  vga.print("══════════════════════════════════════════════════════════════════════════════\n")
  vga.print(" TEZZ-OS Complete System Hardware Discovery Report\n")
  vga.print(" TEZZCORP PRIVATE LIMITED • Hardware Subsystems\n")
  vga.print("══════════════════════════════════════════════════════════════════════════════\n\n")

  // CPU
  vga.set_color(14, 0)
  vga.print("[1] CPU (Central Processing Unit):\n")
  vga.set_color(15, 0)
  vga.print("    Model:   ")
  vga.set_color(10, 0)
  vga.print(cpu.get_brand())
  vga.print("\n")
  vga.set_color(15, 0)
  vga.print("    Vendor:  ")
  vga.print(cpu.get_vendor())
  vga.print(" • ")
  vga.print_int(cpu.get_cores())
  vga.print(" core(s) @ ")
  vga.print_int(cpu.get_mhz())
  vga.print(" MHz\n\n")

  // Memory
  vga.set_color(14, 0)
  vga.print("[2] System Memory (RAM):\n")
  vga.set_color(15, 0)
  vga.print("    Total:   ")
  vga.set_color(10, 0)
  vga.print_int(pmem.total_mb())
  vga.print(" MB Physical Installed\n")
  vga.set_color(15, 0)
  vga.print("    Used:    ")
  vga.set_color(12, 0)
  vga.print_int(pmem.used_mb())
  vga.print(" MB (")
  vga.print_int(pmem.used_kb())
  vga.print(" KB)\n")
  vga.set_color(15, 0)
  vga.print("    Free:    ")
  vga.set_color(10, 0)
  vga.print_int(pmem.free_mb())
  vga.print(" MB Usable Free\n\n")

  // GPU
  vga.set_color(14, 0)
  vga.print("[3] Graphics Processor (GPU):\n")
  vga.set_color(15, 0)
  vga.print("    Device:  ")
  vga.set_color(10, 0)
  vga.print(display.get_vendor())
  vga.print(" - ")
  vga.print(display.get_model())
  vga.print("\n")
  vga.set_color(15, 0)
  vga.print("    Screen:  ")
  vga.print_int(display.get_width())
  vga.print("x")
  vga.print_int(display.get_height())
  vga.print(" @ ")
  vga.print_int(display.get_bpp())
  vga.print(" bpp ARGB8888 (VRAM: ")
  vga.print_int(display.get_vram_mb())
  vga.print(" MB)\n\n")

  // Storage
  vga.set_color(14, 0)
  vga.print("[4] Connected Storage Devices:\n")
  d:int = 0
  found_storage:int = 0
  while d < 4:
    if ata.is_present(d) != 0:
      found_storage = 1
      vga.set_color(15, 0)
      vga.print("    Disk ")
      vga.print_int(d)
      vga.print(":  ")
      vga.set_color(10, 0)
      vga.print(ata.get_name(d))
      vga.print(" [")
      vga.print(ata.get_model(d))
      vga.print("] ")
      vga.set_color(14, 0)
      vga.print_int(ata.get_size_mb(d))
      vga.print(" MB\n")
    d = d + 1
  if found_storage == 0:
    vga.set_color(7, 0)
    vga.print("    No ATA/IDE storage drives detected\n")
  vga.print("\n")

  // Network & Wireless
  vga.set_color(14, 0)
  vga.print("[5] Network, Wi-Fi & Bluetooth:\n")
  vga.set_color(15, 0)
  vga.print("    Wi-Fi:   ")
  vga.set_color(10, 0)
  vga.print(wireless.wifi_get_hardware())
  vga.print(" (wlan0: ")
  vga.print(wireless.wifi_get_ip())
  vga.print(")\n")
  vga.set_color(15, 0)
  vga.print("    BT:      ")
  vga.set_color(10, 0)
  vga.print(wireless.bt_get_hardware())
  vga.print(" (")
  vga.print(wireless.bt_get_version())
  vga.print(")\n\n")

  // Input & Motherboard
  vga.set_color(14, 0)
  vga.print("[6] Motherboard & Peripherals:\n")
  vga.set_color(15, 0)
  vga.print("    Board:   Intel Q35 / ACPI Motherboard Chipset\n")
  vga.print("    Input:   PS/2 Keyboard (IRQ1), PS/2 Mouse (IRQ12, ")
  if mouse.available() != 0:
    vga.set_color(10, 0)
    vga.print("Detected")
  else:
    vga.set_color(14, 0)
    vga.print("Standby")
  vga.set_color(15, 0)
  vga.print(")\n")
  vga.print("    Timers:  PIT 8254 (1000 Hz), RTC MC146818 CMOS Clock, PIC 8259A\n")

  vga.set_color(7, 0)
  ret 0
