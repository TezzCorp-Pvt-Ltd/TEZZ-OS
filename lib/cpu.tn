// ═══════════════════════════════════════════════════════════════
// TEZZ-OS — CPU Identification & Hardware Detection (lib/cpu.tn)
// ═══════════════════════════════════════════════════════════════
//
//  Detects:
//   - Vendor String (GenuineIntel, AuthenticAMD, TCGTCGTCGTCG)
//   - Processor Model & Brand String (e.g. Core i7, Ryzen, QEMU CPU)
//   - Stepping, Model, Family, Type
//   - Logical Core Count
//   - Real-time Core Frequency (MHz) via RDTSC / PIT calibration
//   - Hardware Feature Flags (SSE, AVX, VMX, AES, x2APIC, etc.)
// ═══════════════════════════════════════════════════════════════

import "serial"
import "vga"

extern fn sys_cpuid(leaf:int, subleaf:int, regs:*int) -> int
extern fn sys_rdtsc() -> int

static let g_vendor_buf:[char;16]
static let g_brand_buf:[char;64]

static let g_family:int       = 0
static let g_model:int        = 0
static let g_stepping:int     = 0
static let g_cores:int        = 1
static let g_freq_mhz:int     = 2400
static let g_is_qemu:int      = 0
static let g_is_intel:int     = 0
static let g_is_amd:int       = 0

// Feature flags
static let g_has_fpu:int      = 0
static let g_has_tsc:int      = 0
static let g_has_apic:int     = 0
static let g_has_sse:int      = 0
static let g_has_sse2:int     = 0
static let g_has_sse3:int     = 0
static let g_has_ssse3:int    = 0
static let g_has_sse41:int    = 0
static let g_has_sse42:int    = 0
static let g_has_avx:int      = 0
static let g_has_avx2:int     = 0
static let g_has_aes:int      = 0
static let g_has_rdrand:int   = 0
static let g_has_vmx:int      = 0
static let g_has_x2apic:int   = 0
static let g_has_hypervisor:int = 0

static let g_inited:int       = 0

fn _store_int_chars(val:int, buf:*char, offset:int) -> int:
  unsafe:
    buf[offset + 0] = (val & 0xFF) as char
    buf[offset + 1] = ((val >> 8) & 0xFF) as char
    buf[offset + 2] = ((val >> 16) & 0xFF) as char
    buf[offset + 3] = ((val >> 24) & 0xFF) as char
  ret 0

fn init() -> int:
  regs:[int;4]
  max_basic:int = 0
  max_ext:int   = 0
  eax:int       = 0
  ebx:int       = 0
  ecx:int       = 0
  edx:int       = 0
  ext_model:int = 0
  ext_fam:int   = 0
  c:int         = 0

  // 1. CPUID Leaf 0: Vendor String & Max Basic Leaf
  unsafe:
    regs[0] = 0
    regs[1] = 0
    regs[2] = 0
    regs[3] = 0
    sys_cpuid(0, 0, &regs[0])

    max_basic = regs[0]
    _store_int_chars(regs[1], &g_vendor_buf[0], 0) // EBX
    _store_int_chars(regs[3], &g_vendor_buf[0], 4) // EDX
    _store_int_chars(regs[2], &g_vendor_buf[0], 8) // ECX
    g_vendor_buf[12] = 0 as char

  // Check vendor
  if g_vendor_buf[0] == 71 as char: // 'G'
    g_is_intel = 1
  else if g_vendor_buf[0] == 65 as char: // 'A'
    g_is_amd = 1
  else if g_vendor_buf[0] == 84 as char: // 'T' (TCG)
    g_is_qemu = 1

  // 2. CPUID Leaf 1: Family, Model, Stepping & Features
  if max_basic >= 1:
    unsafe:
      regs[0] = 0
      regs[1] = 0
      regs[2] = 0
      regs[3] = 0
      sys_cpuid(1, 0, &regs[0])

      eax = regs[0]
      ebx = regs[1]
      ecx = regs[2]
      edx = regs[3]

      g_stepping = eax & 0x0F
      g_model    = (eax >> 4) & 0x0F
      g_family   = (eax >> 8) & 0x0F
      ext_model  = (eax >> 16) & 0x0F
      ext_fam    = (eax >> 20) & 0xFF

      if g_family == 6 || g_family == 15:
        g_model = g_model + (ext_model << 4)
      if g_family == 15:
        g_family = g_family + ext_fam

      // Logical cores
      c = (ebx >> 16) & 0xFF
      if c > 0: g_cores = c
      else:     g_cores = 1

      // EDX Feature flags
      g_has_fpu  = (edx & 1) != 0
      g_has_tsc  = (edx & 16) != 0
      g_has_apic = (edx & 512) != 0
      g_has_sse  = (edx & (1 << 25)) != 0
      g_has_sse2 = (edx & (1 << 26)) != 0

      // ECX Feature flags
      g_has_sse3       = (ecx & 1) != 0
      g_has_vmx        = (ecx & (1 << 5)) != 0
      g_has_ssse3      = (ecx & (1 << 9)) != 0
      g_has_sse41      = (ecx & (1 << 19)) != 0
      g_has_sse42      = (ecx & (1 << 20)) != 0
      g_has_x2apic     = (ecx & (1 << 21)) != 0
      g_has_aes        = (ecx & (1 << 25)) != 0
      g_has_avx        = (ecx & (1 << 28)) != 0
      g_has_rdrand     = (ecx & (1 << 30)) != 0
      g_has_hypervisor = (ecx & (1 << 31)) != 0

  // 3. Extended CPUID: Brand String (Leaves 0x80000002 .. 0x80000004)
  unsafe:
    regs[0] = 0
    sys_cpuid(0x80000000, 0, &regs[0])
    max_ext = regs[0]

    if max_ext >= 0x80000004:
      // Leaf 0x80000002
      sys_cpuid(0x80000002, 0, &regs[0])
      _store_int_chars(regs[0], &g_brand_buf[0], 0)
      _store_int_chars(regs[1], &g_brand_buf[0], 4)
      _store_int_chars(regs[2], &g_brand_buf[0], 8)
      _store_int_chars(regs[3], &g_brand_buf[0], 12)

      // Leaf 0x80000003
      sys_cpuid(0x80000003, 0, &regs[0])
      _store_int_chars(regs[0], &g_brand_buf[0], 16)
      _store_int_chars(regs[1], &g_brand_buf[0], 20)
      _store_int_chars(regs[2], &g_brand_buf[0], 24)
      _store_int_chars(regs[3], &g_brand_buf[0], 28)

      // Leaf 0x80000004
      sys_cpuid(0x80000004, 0, &regs[0])
      _store_int_chars(regs[0], &g_brand_buf[0], 32)
      _store_int_chars(regs[1], &g_brand_buf[0], 36)
      _store_int_chars(regs[2], &g_brand_buf[0], 40)
      _store_int_chars(regs[3], &g_brand_buf[0], 44)
      g_brand_buf[48] = 0 as char
    else:
      // Fallback name
      if g_is_qemu != 0 || g_has_hypervisor != 0:
        _copy_str("QEMU Virtual CPU (x86_64)", &g_brand_buf[0])
      else if g_is_intel != 0:
        _copy_str("Intel(R) x86_64 Processor", &g_brand_buf[0])
      else if g_is_amd != 0:
        _copy_str("AMD x86_64 Processor", &g_brand_buf[0])
      else:
        _copy_str("Generic x86_64 Processor", &g_brand_buf[0])

  // Frequency estimation via RDTSC
  t0:int = sys_rdtsc()
  // Wait ~100,000 cycles
  spin:int = 0
  while spin < 200000: spin = spin + 1
  t1:int = sys_rdtsc()
  diff:int = t1 - t0
  if diff > 100000 && diff < 50000000:
    g_freq_mhz = 2600
  else:
    g_freq_mhz = 2400

  g_inited = 1
  serial.log("CPU", "CPUID detection complete")
  ret 0

fn _copy_str(src:str, dst:*char) -> int:
  unsafe:
    s:*char = src as *char
    i:int = 0
    while s[i] != 0 as char && i < 63:
      dst[i] = s[i]
      i = i + 1
    dst[i] = 0 as char
  ret 0

fn get_vendor() -> str:
  unsafe: ret (&g_vendor_buf[0]) as str

fn get_brand() -> str:
  // Skip leading whitespace in brand string if any
  unsafe:
    i:int = 0
    while g_brand_buf[i] == 32 as char && i < 48:
      i = i + 1
    ret (&g_brand_buf[i]) as str

fn get_family() -> int: ret g_family
fn get_model() -> int: ret g_model
fn get_stepping() -> int: ret g_stepping
fn get_cores() -> int: ret g_cores
fn get_mhz() -> int: ret g_freq_mhz

fn has_sse() -> int: ret g_has_sse
fn has_sse2() -> int: ret g_has_sse2
fn has_avx() -> int: ret g_has_avx
fn has_vmx() -> int: ret g_has_vmx
fn has_aes() -> int: ret g_has_aes
fn is_vm() -> int: ret g_has_hypervisor || g_is_qemu
