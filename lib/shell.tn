  ret 1

fn _cmd_mv(src:str, dst:str) -> int:
  if _str_len(src) == 0 || _str_len(dst) == 0:
    vga.print("Usage: mv <source> <dest>\n")
    ret 1
  res:int = vfs.vfs_move(src, dst)
  if res >= 0: ret 0
  vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
  vga.print("mv: failed to move '")
  vga.print(src)
  vga.print("' to '")
  vga.print(dst)
