  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print(wireless.wifi_get_current_ssid())
  vga.print(" (1200 Mbps)\n")

  vga.print("                                    User: ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print(g_current_user)
  vga.print(" (UID ")
  vga.print_int(g_current_uid)
  vga.print(")\n")

  vga.print("                                    Uptime: ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(hrs)
  vga.print("h ")
  vga.print_int(mins % 60)
