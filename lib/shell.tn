fn _cmd_scale(s:int) -> int:
  if s != 1 && s != 2:
    vga.print("Usage: scale [1|2]\n  1 = 1x scale (160x50 compact)\n  2 = 2x scale (80x25 large)\n")
    ret 0
  vga.set_scale(s)
  _print_prompt()
  ret 0

fn _cmd_date() -> int:
  sec:int  = rtc.get_second()
  min:int  = rtc.get_minute()
  hour:int = rtc.get_hour()
  day:int  = rtc.get_day()
  mon:int  = rtc.get_month()
  year:int = rtc.get_year()

  vga.print("\nHardware Real-Time Clock (RTC):\n  ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(year)
  vga.print("-")
  if mon < 10: vga.print("0")
  vga.print_int(mon)
  vga.print("-")
  if day < 10: vga.print("0")
  vga.print_int(day)
  vga.print(" ")
  if hour < 10: vga.print("0")
  vga.print_int(hour)
  vga.print(":")
  if min < 10: vga.print("0")
  vga.print_int(min)
  vga.print(":")
  if sec < 10: vga.print("0")
  vga.print_int(sec)
  vga.set_color(g_fg, g_bg)
  vga.print(" UTC\n\n")
  ret 0

// ─── Argument parsing ────────────────────────────────────────────

// Extract word at position, returns end position ((0 - 1) = no more words)
fn _next_word(line:str, pos:int, out:*char, max:int) -> int:
  p:*char = line as *char
  // Skip spaces
  unsafe:
    while p[pos] == 32 as char: pos = pos + 1
    if p[pos] == 0 as char: ret (0 - 1)
    n:int = 0
    while p[pos] != 0 as char && p[pos] != 32 as char && n < max - 1:
      out[n] = p[pos]
      n = n + 1
      pos = pos + 1
    out[n] = 0 as char
  ret pos

// ─── Filesystem Commands ─────────────────────────────────────────

static let g_write_buf:[char;256]

fn _cmd_pwd() -> int:
  vga.print(vfs.vfs_get_cwd_path())
  vga.print("\n")
  ret 0

fn _cmd_cd(path:str) -> int:
  target:str = path
  if _str_len(path) == 0 || _str_eq(path, "~") != 0:
    target = "/home"
  res:int = vfs.vfs_chdir(target)
  if res != 0:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("cd: no such directory: ")
    vga.print(target)
    vga.print("\n")
    vga.set_color(g_fg, g_bg)
    ret 1
  ret 0

fn _cmd_ls(path:str) -> int:
  target_node:int = vfs.vfs_get_cwd_idx()
  if _str_len(path) > 0:
    resolved:int = vfs.vfs_resolve_path(path)
    if resolved == (0 - 1):
      vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
      vga.print("ls: cannot access '")
      vga.print(path)
      vga.print("': No such file or directory\n")
      vga.set_color(g_fg, g_bg)
      ret 1
    target_node = resolved

  // If target is a file, display that single node
  if vfs.node_type(target_node) == 1:
    vga.print("-rw-r--r--  ")
    vga.print_int(vfs.node_size(target_node))
    vga.print(" B  ")
    vga.print(vfs.node_name(target_node))
    vga.print("\n")
    ret 0

  // Display directory header
  vga.print("\n")
  vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
  vga.print("  Type   Perms      Size  Name\n")
  vga.print("  ────  ───────  ───────  ──────────────────────\n")

  // Always show . and ..
  vga.set_color(COLOR_CYAN, COLOR_BLACK)
  vga.print("  DIR   drwxr-xr-x     -  .\n")
  vga.print("  DIR   drwxr-xr-x     -  ..\n")

  child:int = vfs.node_first_child(target_node)
  count:int = 0
  total_bytes:int = 0

  while child != (0 - 1):
    ntype:int = vfs.node_type(child)
    nsize:int = vfs.node_size(child)
    nname:str = vfs.node_name(child)
    total_bytes = total_bytes + nsize
    count = count + 1

    if ntype == 2:
      vga.set_color(COLOR_LIGHT_BLUE, COLOR_BLACK)
      vga.print("  DIR   drwxr-xr-x     -  ")
      vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
      vga.print(nname)
      vga.print("/\n")
    else:
      if ntype == 3:
        vga.set_color(COLOR_YELLOW, COLOR_BLACK)
        vga.print("  DEV   crw-rw----     0  ")
        vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
        vga.print(nname)
        vga.print("\n")
      else:
        vga.set_color(COLOR_LIGHT_GREY, COLOR_BLACK)
        vga.print("  FILE  -rw-r--r--")
        if nsize < 10: vga.print("      ")
        else:
          if nsize < 100: vga.print("     ")
          else:
            if nsize < 1000: vga.print("    ")
            else:
              if nsize < 10000: vga.print("   ")
              else: vga.print("  ")
        vga.set_color(COLOR_WHITE, COLOR_BLACK)
        vga.print_int(nsize)
        vga.print("B  ")
        vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
        vga.print(nname)
        vga.print("\n")

    child = vfs.node_next_sibling(child)

  vga.set_color(g_fg, g_bg)
  vga.print("  ────  ───────  ───────  ──────────────────────\n")
  vga.print("  Total: ")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print_int(count)
  vga.set_color(g_fg, g_bg)
  vga.print(" entries (")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print_int(total_bytes)
  vga.set_color(g_fg, g_bg)
  vga.print(" bytes in files)\n\n")
  ret 0

fn _cmd_cat(path:str) -> int:
  if _str_len(path) == 0:
    vga.print("Usage: cat <file>\n")
    ret 0
  node:int = vfs.vfs_resolve_path(path)
  if node == (0 - 1):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("cat: ")
    vga.print(path)
    vga.print(": No such file or directory\n")
    vga.set_color(g_fg, g_bg)
    ret 1
  if vfs.node_type(node) == 2:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("cat: ")
    vga.print(path)
    vga.print(": Is a directory\n")
    vga.set_color(g_fg, g_bg)
    ret 1
  content:str = vfs.vfs_read_file(path)
  if _str_len(content) == 0:
    ret 0
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print(content)
  vga.set_color(g_fg, g_bg)
  p:*char = content as *char
  cl:int = _str_len(content)
  unsafe:
    if cl > 0 && p[cl - 1] != 10 as char:
      vga.print("\n")
  ret 0

fn _cmd_touch(path:str) -> int:
  if _str_len(path) == 0:
    vga.print("Usage: touch <file>\n")
    ret 0
  res:int = vfs.vfs_touch(path)
  if res == (0 - 1):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("touch: cannot touch '")
    vga.print(path)
    vga.print("'\n")
    vga.set_color(g_fg, g_bg)
    ret 1
  ret 0

fn _cmd_mkdir(path:str) -> int:
  if _str_len(path) == 0:
    vga.print("Usage: mkdir <directory>\n")
    ret 0
  res:int = vfs.vfs_mkdir(path)
  if res == (0 - 1):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("mkdir: cannot create directory '")
    vga.print(path)
    vga.print("': File exists or invalid path\n")
    vga.set_color(g_fg, g_bg)
    ret 1
  ret 0

fn _cmd_rm(path:str) -> int:
  if _str_len(path) == 0:
    vga.print("Usage: rm <file|directory>\n")
    ret 0

  target_node:int = vfs.vfs_resolve_path(path)
  if target_node <= 0:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("rm: cannot remove '")
    vga.print(path)
    vga.print("': No such file or directory\n")
    vga.set_color(g_fg, g_bg)
    ret 1

  if vfs.vfs_is_readonly(target_node) != 0:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("rm: cannot remove '")
    vga.print(path)
    vga.print("': Kernel file is read-only protected\n")
    vga.set_color(g_fg, g_bg)
    ret 1

  // Permission check: if normal user (UID 1000), only allow deleting files owned by user
  if g_current_uid != 0:
    if vfs.vfs_get_owner(target_node) != g_current_uid:
      vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
      vga.print("rm: cannot remove '")
      vga.print(path)
      vga.print("': Permission denied. Superuser privilege required (use 'super').\n")
      vga.set_color(g_fg, g_bg)
      ret 1

  res:int = vfs.vfs_remove(path)
  if res == 0:
    ret 0
  else if res == (0 - 1):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("rm: cannot remove '")
    vga.print(path)
    vga.print("': No such file or directory\n")
    vga.set_color(g_fg, g_bg)
  else if res == (0 - 2):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("rm: cannot remove '")
    vga.print(path)
    vga.print("': Directory not empty\n")
    vga.set_color(g_fg, g_bg)
  else if res == (0 - 3):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("rm: cannot remove '")
    vga.print(path)
    vga.print("': Kernel file is read-only protected\n")
    vga.set_color(g_fg, g_bg)
  ret 1

fn _cmd_write(line:str, append_mode:int) -> int:
  pos:int = _next_word(line, 0, &g_word0[0], MAX_ARG_LEN)
  if pos == (0 - 1):
    vga.print("Usage: write <file> <text>\n")
    ret 0
  p2:int = _next_word(line, pos, &g_word1[0], MAX_ARG_LEN)
  if p2 == (0 - 1):
    vga.print("Usage: write <file> <text>\n")
    ret 0

  file_path:str = ""
  unsafe: file_path = (&g_word1[0]) as str

  p:*char = line as *char
  unsafe:
    while p[p2] == 32 as char:
      p2 = p2 + 1
    w_len:int = 0
    while p[p2] != 0 as char && w_len < 255:
      g_write_buf[w_len] = p[p2]
      w_len = w_len + 1
      p2 = p2 + 1
    g_write_buf[w_len] = 0 as char

  content:str = ""
  unsafe: content = (&g_write_buf[0]) as str

  bytes:int = 0
  if append_mode != 0:
    bytes = vfs.vfs_append_file(file_path, content)
  else:
    bytes = vfs.vfs_write_file(file_path, content)

  if bytes < 0:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("write: failed to write to '")
    vga.print(file_path)
    vga.print("'\n")
    vga.set_color(g_fg, g_bg)
    ret 1

  vga.print("Wrote ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(bytes)
  vga.set_color(g_fg, g_bg)
  vga.print(" bytes to '")
  vga.print(file_path)
  vga.print("'\n")
  ret 0

fn _cmd_stat(path:str) -> int:
  if _str_len(path) == 0:
    vga.print("Usage: stat <file|directory>\n")
    ret 0
  node:int = vfs.vfs_resolve_path(path)
  if node == (0 - 1):
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("stat: cannot stat '")
    vga.print(path)
    vga.print("': No such file or directory\n")
    vga.set_color(g_fg, g_bg)
    ret 1

  vga.print("\n  File: ")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print(vfs.node_name(node))
  vga.print("\n")
  vga.set_color(g_fg, g_bg)
  vga.print("  Size: ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(vfs.node_size(node))
  vga.set_color(g_fg, g_bg)
  vga.print(" bytes\n  Type: ")
  vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
  ntype:int = vfs.node_type(node)
  if ntype == 1: vga.print("Regular File\n")
  else:
    if ntype == 2: vga.print("Directory\n")
    else:
      if ntype == 3: vga.print("Character Device\n")
      else: vga.print("Unknown\n")
  vga.set_color(g_fg, g_bg)
  vga.print("  Node: ")
  vga.print_int(node)
  vga.print("  (Parent Node: ")
  vga.print_int(vfs.node_parent(node))
  vga.print(")\n  Perm: 0")
  vga.set_color(COLOR_YELLOW, COLOR_BLACK)
  perm:int = vfs.node_perm(node)
  vga.print_int(perm / 64)
  vga.print_int((perm / 8) % 8)
  vga.print_int(perm % 8)
  vga.set_color(g_fg, g_bg)
  vga.print("\n\n")
  ret 0

fn _cmd_df() -> int:
  used_nodes:int = 0
  total_bytes:int = 0
  i:int = 0
  while i < 128:
    if vfs.node_in_use(i) != 0:
      used_nodes = used_nodes + 1
      total_bytes = total_bytes + vfs.node_size(i)
    i = i + 1

  free_nodes:int = 128 - used_nodes
  node_pct:int = (used_nodes * 100) / 128

  vga.print("\n")
  vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
  vga.print("Filesystem      Type     Inodes  Used  Free  Use%  Bytes Used  Mounted on\n")
  vga.print("──────────  ────────  ─────────  ────  ────  ────  ──────────  ──────────\n")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print("rootfs           vfs        128    ")
  if used_nodes < 10: vga.print(" ")
  vga.print_int(used_nodes)
  vga.print("   ")
  if free_nodes < 100: vga.print(" ")
  vga.print_int(free_nodes)
  vga.print("   ")
  if node_pct < 10: vga.print(" ")
  vga.print_int(node_pct)
  vga.print("%      ")
  if total_bytes < 1000: vga.print(" ")
  vga.print_int(total_bytes)
  vga.print(" B  /\n")
  vga.set_color(g_fg, g_bg)
  vga.print("──────────  ────────  ─────────  ────  ────  ────  ──────────  ──────────\n\n")
  ret 0

// ─── Command dispatch ────────────────────────────────────────────

// ─── Super User & Permission Manager ─────────────────────────────

fn _cmd_super(arg:str) -> int:
  if g_current_uid == 0:
    if _str_eq(arg, "exit") != 0 || _str_eq(arg, "-u user") != 0:
      g_current_uid = 1000
      g_current_user = "user"
      vga.set_color(COLOR_YELLOW, COLOR_BLACK)
      vga.print("[AUTH] Superuser privileges dropped. Active user: user (UID 1000).\n")
      vga.set_color(g_fg, g_bg)
      ret 0
    vga.print("Already running with superuser (root) privileges.\nType 'super exit' to return to normal user.\n")
    ret 0

  // Elevate from normal user to root (password: tezz)
  if _str_len(arg) == 0 || _str_eq(arg, "tezz") != 0:
    g_current_uid = 0
    g_current_user = "root"
    vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
    vga.print("[AUTH] Superuser privileges activated. Active user: root (UID 0).\n")
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("Notice: System and kernel files are now accessible with root authority.\n")
    vga.set_color(g_fg, g_bg)
    ret 0

  vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
  vga.print("[AUTH] Permission denied: invalid superuser credentials.\n")
  vga.set_color(g_fg, g_bg)
  ret 1

fn _cmd_whoami() -> int:
  vga.print(g_current_user)
  vga.print(" (UID ")
  vga.print_int(g_current_uid)
  if g_current_uid == 0:
    vga.print(" - Superuser)\n")
  else:
    vga.print(" - Normal User)\n")
  ret 0

fn _cmd_id() -> int:
  vga.print("uid=")
  vga.print_int(g_current_uid)
  vga.print("(")
  vga.print(g_current_user)
  vga.print(") gid=")
  vga.print_int(g_current_uid)
  vga.print("(")
  vga.print(g_current_user)
  vga.print(") groups=")
  vga.print_int(g_current_uid)
  vga.print("(")
  vga.print(g_current_user)
  vga.print(")\n")
  ret 0

// ─── Bare-Metal Mouse Diagnostics & Reset ────────────────────────

fn _cmd_mouse(arg:str) -> int:
  if _str_eq(arg, "reset") != 0 || _str_eq(arg, "init") != 0:
    vga.print("Re-probing PS/2 and auxiliary mouse hardware...\n")
    mouse.reset()
    if mouse.available() != 0:
      vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
      vga.print("Mouse hardware detected and initialized successfully!\n")
    else:
      vga.set_color(COLOR_YELLOW, COLOR_BLACK)
      vga.print("Mouse not detected on auxiliary port.\n")
    vga.set_color(g_fg, g_bg)
    ret 0

  vga.print("PS/2 Mouse Hardware Status:\n")
  vga.print("  Hardware Present : ")
  if mouse.available() != 0:
    vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
    vga.print("YES (Active)\n")
  else:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("NO (Keyboard-only mode)\n")
  vga.set_color(g_fg, g_bg)
  vga.print("  Wheel Supported  : ")
  if mouse.has_wheel() != 0: vga.print("YES (IntelliMouse 4-byte packets)\n")
  else: vga.print("NO (Standard 3-byte packets)\n")
  vga.print("  Position (Pixels): X=")
  vga.print_int(mouse.pixel_x())
  vga.print(", Y=")
  vga.print_int(mouse.pixel_y())
  vga.print("\n")
  vga.print("  Position (Text)  : Col=")
  vga.print_int(mouse.x())
  vga.print(", Row=")
  vga.print_int(mouse.y())
  vga.print("\n")
  vga.print("Use 'mouse reset' to force hardware re-probe.\n")
  ret 0

// ─── User Space Filesystem Tools (cp, mv, edit) ──────────────────

fn _cmd_cp(src:str, dst:str) -> int:
  if _str_len(src) == 0 || _str_len(dst) == 0:
    vga.print("Usage: cp <source_file> <dest_file>\n")
