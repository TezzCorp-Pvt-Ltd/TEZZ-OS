fn _cmd_reboot() -> int:
  vga.set_color(COLOR_YELLOW, COLOR_BLACK)
  vga.print("\nRebooting...\n")
  pit.sleep_ms(500)
  // Trigger reboot via PS/2 controller (classic method)
  sys.sys_outb(0x64, 0xFE)
  while 1: 1
  ret 0

fn _cmd_shutdown() -> int:
  vga.set_color(COLOR_YELLOW, COLOR_BLACK)
  vga.print("\nShutting down... Goodbye!\n")
  pit.sleep_ms(500)
  // QEMU ACPI shutdown via port 0x604 (ACPI PM1a control)
  sys.sys_outb(0x604, 0x2000)
  // VirtualBox / Bochs
  sys.sys_outb(0xB004, 0x2000)
  while 1: 1
  ret 0

