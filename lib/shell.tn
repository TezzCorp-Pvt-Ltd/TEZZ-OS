  vga.print("To append or write, use:\n  append ")
  vga.print(path)
  vga.print(" <text>\n  write ")
  vga.print(path)
  vga.print(" <text>\n")
  vga.set_color(g_fg, g_bg)
  ret 0

// ─── Calculator & Utilities (calc, cowsay, matrix) ───────────────

fn _cmd_calc(line:str) -> int:
  p:*char = line as *char
  i:int = 4 // skip "calc"
  unsafe:
    while p[i] == 32 as char: i = i + 1
    if p[i] == 0 as char:
      vga.print("Usage: calc <num> <+|-|*|/> <num>\nExample: calc 25 * 4\n")
      ret 1
    n1:int = 0
    while p[i] >= 48 as char && p[i] <= 57 as char:
      n1 = n1 * 10 + (p[i] as int - 48)
      i = i + 1
    while p[i] == 32 as char: i = i + 1
    op:int = p[i] as int
    if op != 0: i = i + 1
    while p[i] == 32 as char: i = i + 1
    n2:int = 0
    while p[i] >= 48 as char && p[i] <= 57 as char:
      n2 = n2 * 10 + (p[i] as int - 48)
      i = i + 1
    ans:int = 0
    if op == 43: ans = n1 + n2       // '+'
    else if op == 45: ans = n1 - n2  // '-'
    else if op == 42: ans = n1 * n2  // '*'
    else if op == 47:               // '/'
      if n2 == 0:
        vga.print("calc: division by zero error\n")
        ret 1
      ans = n1 / n2
    else:
      vga.print("calc: unknown operator. Supported: +, -, *, /\n")
      ret 1
    vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
    vga.print("= ")
    vga.print_int(ans)
    vga.print("\n")
    vga.set_color(g_fg, g_bg)
  ret 0

fn _cmd_cowsay(line:str) -> int:
  p:*char = line as *char
  i:int = 6 // skip "cowsay"
  msg:str = "Hello from TEZZ-OS!"
  unsafe:
    while p[i] == 32 as char: i = i + 1
    if p[i] != 0 as char:
      msg = (&p[i]) as str
  vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
  vga.print(" < ")
  vga.print(msg)
  vga.print(" >\n")
  vga.print(" -----------------------------\n")
  vga.print("        \\   ^__^\n")
  vga.print("         \\  (oo)\\_______\n")
  vga.print("            (__)\\       )\\/\\\n")
  vga.print("                ||----w |\n")
  vga.print("                ||     ||\n\n")
  vga.set_color(g_fg, g_bg)
  ret 0

fn _cmd_matrix() -> int:
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print("01011010  TEZZ-OS NOVA MATRIX STREAM  01100101\n")
  vga.print("10100101  Wake up, user... The TEZZ kernel has you.  11010010\n")
  vga.print("00110011  Follow the cyan rabbit. https://tezzcorp.com  01010101\n")
  vga.set_color(g_fg, g_bg)
  ret 0

// ─── TEZZ-OS Package Manager (tezz) ──────────────────────────────

fn _cmd_tezz(subcmd:str, pkg:str) -> int:
  if _str_len(subcmd) == 0 || _str_eq(subcmd, "help") != 0:
    vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
    vga.print("TEZZ-OS Package Manager (TEZZ-PKG v1.0.0)\n")
    vga.set_color(COLOR_WHITE, COLOR_BLACK)
    vga.print("Corporate: TEZZCORP PRIVATE LIMITED (https://tezzcorp.com)\n")
    vga.print("Usage: tezz <command> [package]\n\n")
    vga.print("Commands:\n")
    vga.print("  list              List all available and installed packages\n")
    vga.print("  install <pkg>     Install package to /bin\n")
    vga.print("  remove <pkg>      Uninstall package\n")
    vga.print("  update            Synchronize repository metadata\n")
    vga.print("  upgrade           Upgrade all installed packages\n")
    vga.print("  info <pkg>        Display package metadata\n")
    vga.set_color(g_fg, g_bg)
    ret 0

  if _str_eq(subcmd, "update") != 0:
    vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
    vga.print("[TEZZ-PKG] Synchronizing official repository: https://pkg.tezzcorp.com/os/x86_64\n")
    vga.set_color(g_fg, g_bg)
    vga.print("[TEZZ-PKG] Fetching package index... 200 OK (6 packages indexed)\n")
    vga.print("[TEZZ-PKG] All repository catalogs are up to date.\n")
    ret 0

  if _str_eq(subcmd, "upgrade") != 0:
    vga.print("[TEZZ-PKG] Checking installed packages in /bin...\n")
    vga.print("[TEZZ-PKG] All installed packages are at the latest version.\n")
    ret 0

  if _str_eq(subcmd, "list") != 0:
    vga.print("\n")
    vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
    vga.print("Package     Version  Status       Description\n")
    vga.print("──────────  ───────  ───────────  ────────────────────────────────────────────\n")
    vga.set_color(COLOR_WHITE, COLOR_BLACK)
    vga.print("calc        1.2.0    [installed]  Math expression calculator\n")
    vga.print("cowsay      2.1.0    [installed]  Configurable ASCII talking cow generator\n")
    vga.print("edit        1.0.4    [installed]  Interactive in-terminal file and code editor\n")
    vga.print("matrix      1.1.0    [installed]  Digital green matrix animation screensaver\n")
    vga.print("guess       1.0.0    [available]  Interactive number guessing mini-game\n")
    vga.print("nettools    0.9.1    [available]  Network ping and diagnostic utilities\n")
    vga.set_color(g_fg, g_bg)
    vga.print("──────────  ───────  ───────────  ────────────────────────────────────────────\n\n")
    ret 0

  if _str_eq(subcmd, "install") != 0:
    if _str_len(pkg) == 0:
      vga.print("Usage: tezz install <package_name>\n")
      ret 1
    vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
    vga.print("[TEZZ-PKG] Resolving dependencies for '")
    vga.print(pkg)
    vga.print("'...\n")
    vga.set_color(g_fg, g_bg)
    vga.print("[TEZZ-PKG] Downloading ")
    vga.print(pkg)
    vga.print("-1.0.0-x86_64.tpk (14.2 KB)...\n")
    vga.print("[TEZZ-PKG] Verifying package signature (TEZZCORP GPG Key)... OK\n")
    vfs.vfs_touch(pkg)
    vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
    vga.print("[TEZZ-PKG] Package '")
    vga.print(pkg)
    vga.print("' installed successfully!\n")
    vga.set_color(g_fg, g_bg)
    ret 0

  if _str_eq(subcmd, "remove") != 0:
    if _str_len(pkg) == 0:
      vga.print("Usage: tezz remove <package_name>\n")
      ret 1
    vga.print("[TEZZ-PKG] Package '")
    vga.print(pkg)
    vga.print("' removed successfully.\n")
    ret 0

  if _str_eq(subcmd, "info") != 0:
    if _str_len(pkg) == 0:
      vga.print("Usage: tezz info <package_name>\n")
      ret 1
    vga.print("Package     : ")
    vga.print(pkg)
    vga.print("\nVersion     : 1.0.0\nArchitecture: x86_64\nMaintainer  : TEZZCORP Systems Team <info@tezzcorp.com>\nWebsite     : https://tezzcorp.com/packages\nLicense     : TEZZ-OS Open License\n")
    ret 0

  vga.print("tezz: unknown subcommand '")
  vga.print(subcmd)
  vga.print("'. Type 'tezz help' for usage.\n")
  ret 1

static let g_word0:[char;64]
static let g_word1:[char;64]
static let g_word2:[char;64]


fn _cmd_wifi(cmd_type:str, param:str) -> int:
  if _str_len(cmd_type) == 0 || _str_eq(cmd_type, "status") != 0:
    ret hw.print_wifi()

  if _str_eq(cmd_type, "scan") != 0:
    vga.set_color(11, 0)
    vga.print("[WIFI] Scanning 2.4 GHz and 5.0 GHz spectrum channels 1-165...\n")
    pit.sleep_ms(200)
    ret hw.print_wifi()

  if _str_eq(cmd_type, "connect") != 0:
    target_ssid:str = param
    if _str_len(target_ssid) == 0: target_ssid = "TEZZ-CORP-5G"
    vga.set_color(11, 0)
    vga.print("[WIFI] Associating with '")
    vga.print(target_ssid)
    vga.print("'...\n")
    vga.print("[WIFI] WPA3-SAE Key Exchange... Authenticated!\n")
    vga.print("[WIFI] DHCP Client -> IP: 192.168.1.142, Gateway: 192.168.1.1, DNS: 1.1.1.1\n")
    vga.set_color(10, 0)
    vga.print("[WIFI] Link connected: 1200 Mbps (Wi-Fi 6 AX200)\n")
    wireless.wifi_connect(target_ssid)
    ret 0

  if _str_eq(cmd_type, "disconnect") != 0:
    wireless.wifi_disconnect()
    vga.set_color(14, 0)
    vga.print("[WIFI] Interface wlan0 disconnected.\n")
    ret 0

  vga.print("Usage: wifi [status|scan|connect <ssid>|disconnect]\n")
  ret 0

fn _cmd_bt(cmd_type:str, param:str) -> int:
  if _str_len(cmd_type) == 0 || _str_eq(cmd_type, "status") != 0:
    ret hw.print_bt()

  if _str_eq(cmd_type, "scan") != 0:
    vga.set_color(11, 0)
    vga.print("[BT] Scanning 2.4 GHz Bluetooth spectrum for nearby peripherals...\n")
    pit.sleep_ms(200)
    ret hw.print_bt()

  if _str_eq(cmd_type, "pair") != 0:
    vga.set_color(11, 0)
    vga.print("[BT] Authenticating with '")
    vga.print(param)
    vga.print("'...\n")
    vga.set_color(10, 0)
    vga.print("[BT] Device paired successfully (A2DP / HID link ready)\n")
    ret 0

fn _str_to_int(s:str) -> int:
  if s == 0: ret 0
  res:int = 0
  unsafe:
    p:*char = s as *char
    i:int = 0
    while p[i] != 0 as char:
      if p[i] >= 48 as char && p[i] <= 57 as char:
        res = res * 10 + (p[i] as int - 48)
      i = i + 1
  ret res

fn _cmd_hexview(drive_str:str, lba_str:str) -> int:
  d_idx:int = 0
  if _str_len(drive_str) > 0:
    d_idx = _str_to_int(drive_str)
  lba:int = 0
  if _str_len(lba_str) > 0:
    lba = _str_to_int(lba_str)

  if ata.is_present(d_idx) == 0:
    vga.set_color(12, 0)
    vga.print("hexview: Drive ")
    vga.print_int(d_idx)
    vga.print(" is not connected.\n")
    ret 0

  vga.set_color(11, 0)
  vga.print("Dumping sector LBA ")
  vga.print_int(lba)
  vga.print(" from ")
  vga.print(ata.get_name(d_idx))
  vga.print(":\n\n")

  unsafe:
    if ata.read_sector(d_idx, lba, &g_hexview_buf[0]) != 0:
      vga.set_color(12, 0)
      vga.print("hexview: Sector read failed (device I/O timeout)\n")
      ret 0

    row:int = 0
    while row < 8:
      vga.set_color(14, 0)
      vga.print("  ")
      offset:int = row * 16
      vga.print_hex(offset, 4)
      vga.print(": ")

      col:int = 0
      while col < 16:
        b:int = (g_hexview_buf[row * 16 + col] as int) & 0xFF
        vga.set_color(15, 0)
        vga.print_hex(b, 2)
        vga.print(" ")
        col = col + 1

      vga.set_color(11, 0)
      vga.print(" | ")

      col = 0
      while col < 16:
        ch:int = (g_hexview_buf[row * 16 + col] as int) & 0xFF
        if ch >= 32 && ch <= 126:
          vga.set_color(10, 0)
          vga.putc(ch)
        else:
          vga.set_color(8, 0)
          vga.putc(46)
        col = col + 1

      vga.print("\n")
      row = row + 1

  vga.set_color(7, 0)
  vga.print("\n")
  ret 0

fn _dispatch(line:str) -> int:
  // Parse command word
  pos:int = _next_word(line, 0, &g_word0[0], MAX_ARG_LEN)
  if pos == (0 - 1): ret 0   // empty line

  // Second word (argument)
  arg_int:int = 0
  has_arg:int = 0
  has_arg2:int = 0
  p2:int = 0
  if pos >= 0:
    p2 = _next_word(line, pos, &g_word1[0], MAX_ARG_LEN)
    if p2 != (0 - 1):
      has_arg = 1
      // Parse integer arg if needed
      unsafe:
        dp:*char = &g_word1[0]
        while dp[0] != 0 as char:
          if dp[0] >= 48 as char && dp[0] <= 57 as char:
            arg_int = arg_int * 10 + (dp[0] as int - 48)
          dp = dp + 1

  if has_arg != 0 && p2 >= 0:
    p3:int = _next_word(line, p2, &g_word2[0], MAX_ARG_LEN)
    if p3 != (0 - 1):
      has_arg2 = 1

  cmd:str = ""
  unsafe: cmd = (&g_word0[0]) as str

  if _str_eq(cmd, "help") != 0:
    ret _cmd_help()

  if _str_eq(cmd, "clear") != 0:
    vga.clear()
    _print_prompt()
    ret 0

  if _str_eq(cmd, "version") != 0:
    ret _cmd_version()

  if _str_eq(cmd, "mem") != 0:
    ret _cmd_mem()

  if _str_eq(cmd, "uptime") != 0:
    ret _cmd_uptime()

  if _str_eq(cmd, "cpuid") != 0:
    ret _cmd_cpuid()

  if _str_eq(cmd, "history") != 0:
    ret _cmd_history()

  if _str_eq(cmd, "neofetch") != 0:
    ret _cmd_neofetch()

  if _str_eq(cmd, "reboot") != 0:
    ret _cmd_reboot()

  if _str_eq(cmd, "shutdown") != 0:
    ret _cmd_shutdown()

  if _str_eq(cmd, "exit") != 0:
    ret _cmd_shutdown()

  if _str_eq(cmd, "fonts") != 0 || _str_eq(cmd, "font") != 0:
    ret _cmd_fonts()

  if _str_eq(cmd, "scale") != 0:
    ret _cmd_scale(arg_int)

  if _str_eq(cmd, "date") != 0 || _str_eq(cmd, "time") != 0:
    ret _cmd_date()

  if _str_eq(cmd, "proc") != 0:
    ret _cmd_proc()

  if _str_eq(cmd, "color") != 0:
    ret _cmd_color(arg_int)

  if _str_eq(cmd, "echo") != 0:
    // Print everything after "echo "
    p:*char = line as *char
    i:int = 4  // skip "echo"
    unsafe: if p[i] == 32 as char: i = i + 1
    unsafe:
      while p[i] != 0 as char:
        vga.putc(p[i] as int)
        i = i + 1
    vga.print("\n")
    ret 0

  arg_str:str = ""
  if has_arg != 0:
    unsafe: arg_str = (&g_word1[0]) as str

  if _str_eq(cmd, "pwd") != 0:
    ret _cmd_pwd()

  if _str_eq(cmd, "cd") != 0:
    ret _cmd_cd(arg_str)

  if _str_eq(cmd, "ls") != 0 || _str_eq(cmd, "dir") != 0:
    ret _cmd_ls(arg_str)

  if _str_eq(cmd, "cat") != 0 || _str_eq(cmd, "type") != 0:
    ret _cmd_cat(arg_str)

  if _str_eq(cmd, "touch") != 0:
    ret _cmd_touch(arg_str)

  if _str_eq(cmd, "mkdir") != 0:
    ret _cmd_mkdir(arg_str)

  if _str_eq(cmd, "rm") != 0:
    ret _cmd_rm(arg_str)

  if _str_eq(cmd, "write") != 0:
    ret _cmd_write(line, 0)

  if _str_eq(cmd, "append") != 0:
    ret _cmd_write(line, 1)

  if _str_eq(cmd, "stat") != 0:
    ret _cmd_stat(arg_str)

  if _str_eq(cmd, "df") != 0:
    ret _cmd_df()

  arg_str2:str = ""
  if has_arg2 != 0:
    unsafe: arg_str2 = (&g_word2[0]) as str

  if _str_eq(cmd, "super") != 0 || _str_eq(cmd, "su") != 0:
    ret _cmd_super(arg_str)

  if _str_eq(cmd, "whoami") != 0:
    ret _cmd_whoami()

  if _str_eq(cmd, "id") != 0:
    ret _cmd_id()

  if _str_eq(cmd, "mouse") != 0:
    ret _cmd_mouse(arg_str)

  if _str_eq(cmd, "cp") != 0:
    ret _cmd_cp(arg_str, arg_str2)

  if _str_eq(cmd, "mv") != 0:
    ret _cmd_mv(arg_str, arg_str2)

  if _str_eq(cmd, "lscpu") != 0 || _str_eq(cmd, "cpuinfo") != 0:
    ret hw.print_lscpu()

  if _str_eq(cmd, "free") != 0:
    ret hw.print_free()

  if _str_eq(cmd, "lspci") != 0:
    ret hw.print_lspci()

  if _str_eq(cmd, "lsblk") != 0 || _str_eq(cmd, "storage") != 0:
    ret hw.print_lsblk()

  if _str_eq(cmd, "gpuinfo") != 0:
    ret hw.print_gpuinfo()

  if _str_eq(cmd, "wifi") != 0:
    ret _cmd_wifi(arg_str, arg_str2)

  if _str_eq(cmd, "bt") != 0 || _str_eq(cmd, "bluetooth") != 0:
    ret _cmd_bt(arg_str, arg_str2)

  if _str_eq(cmd, "hwinfo") != 0:
    ret hw.print_hwinfo()

  if _str_eq(cmd, "hexview") != 0 || _str_eq(cmd, "readsec") != 0:
    ret _cmd_hexview(arg_str, arg_str2)

  if _str_eq(cmd, "edit") != 0:
    ret _cmd_edit(arg_str)

  if _str_eq(cmd, "calc") != 0:
    ret _cmd_calc(line)

  if _str_eq(cmd, "cowsay") != 0:
    ret _cmd_cowsay(line)

  if _str_eq(cmd, "matrix") != 0:
    ret _cmd_matrix()

  if _str_eq(cmd, "tezz") != 0:
    ret _cmd_tezz(arg_str, arg_str2)

  // Unknown command
  vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
  vga.print("Unknown command: '")
  vga.print(cmd)
  vga.print("'. Type 'help' for a list.\n")
  vga.set_color(g_fg, g_bg)
  ret 1

// ─── Main shell input loop ───────────────────────────────────────

fn _handle_mouse() -> int:
  if mouse.available() == 0: ret 0
  if mouse.has_event() == 0: ret 0
  ev:MouseEvent
  if mouse.read_event(&ev) != 0: ret 0

  // 1. Mouse wheel / touchpad: scroll terminal output history!
  if ev.scroll != 0:
    if ev.scroll > 0:
      vga.scroll_view(3)
    else:
      vga.scroll_view(0 - 3)
    ret 1

  // 2. Left click
  if (ev.buttons & 1) != 0:
    // Check if clicked or dragging on the right-hand scrollbar first!
    if vga.handle_scrollbar_click(ev.px, ev.py) != 0:
      ret 1

    // Left click on input row: position shell cursor
    input_row:int = vga.cursor_row()
    if ev.y == input_row:
      new_cur:int = ev.x - g_prompt_len
      if new_cur < 0: new_cur = 0
      if new_cur > g_input_len: new_cur = g_input_len
      g_cursor = new_cur
      vga.cursor_set(input_row, g_prompt_len + g_cursor)
  else:
    vga.scrollbar_release()
  ret 0

fn run() -> int:
  vga.set_color(g_fg, g_bg)

  // Welcome message
  vga.set_color(COLOR_LIGHT_GREY, COLOR_BLACK)
  vga.print("Type '")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print("help")
  vga.set_color(COLOR_LIGHT_GREY, COLOR_BLACK)
  vga.print("' to see available commands.\n\n")
  vga.set_color(g_fg, g_bg)

  _print_prompt()

  while 1:
    // Handle mouse events non-blocking
    _handle_mouse()

    // Update prompt cursor blinking & rendering
    vga.cursor_update()

    // Check for keyboard event
    if keyboard.has_event() == 0: continue

    ev:KeyEvent
    if keyboard.read_event(&ev) != 0: continue
    if ev.pressed == 0: continue   // key release, ignore

    kc:int = ev.keycode
    mods:int = ev.modifiers

    if kc == KEY_PGUP:
      vga.page_up()
      continue

    if kc == KEY_PGDN:
      vga.page_down()
      continue

    // ── Ctrl combinations ──
    if (mods & MOD_CTRL) != 0:
      if kc == 108 || kc == 76:   // Ctrl+L
        vga.clear()
        _print_prompt()
        _redraw_input()
        continue
      if kc == 99 || kc == 67:    // Ctrl+C
        vga.print("^C\n")
        g_input_len = 0
        g_cursor    = 0
        _print_prompt()
        continue
      if kc == 100 || kc == 68:   // Ctrl+D
        vga.print("^D\n")
        _cmd_shutdown()
        continue

    // ── Enter ──
    if kc == KEY_ENTER:
      if vga.get_scroll_offset() > 0:
        vga.scroll_to_bottom()
      vga.print("\n")
      if g_input_len > 0:
        line:str = _buf_to_str(&g_input[0], g_input_len)
        _hist_push(line)
        _dispatch(line)
      g_input_len = 0
      g_cursor    = 0
      _print_prompt()
      continue

    // ── Backspace ──
    if kc == KEY_BACKSPACE:
      if g_cursor > 0:
        // Shift chars left
        i:int = g_cursor - 1
        while i < g_input_len - 1:
          unsafe: g_input[i] = g_input[i + 1]
          i = i + 1
        g_input_len = g_input_len - 1
        g_cursor    = g_cursor - 1
        _redraw_input()
      continue

    // ── Delete ──
    if kc == KEY_DEL:
      if g_cursor < g_input_len:
        i:int = g_cursor
        while i < g_input_len - 1:
          unsafe: g_input[i] = g_input[i + 1]
          i = i + 1
        g_input_len = g_input_len - 1
        _redraw_input()
      continue

    // ── Arrow keys ──
    if kc == KEY_LEFT:
      if g_cursor > 0:
        g_cursor = g_cursor - 1
        vga.cursor_set(vga.cursor_row(), g_prompt_len + g_cursor)
      continue

    if kc == KEY_RIGHT:
      if g_cursor < g_input_len:
        g_cursor = g_cursor + 1
        vga.cursor_set(vga.cursor_row(), g_prompt_len + g_cursor)
      continue

    if kc == KEY_HOME:
      g_cursor = 0
      vga.cursor_set(vga.cursor_row(), g_prompt_len)
      continue

    if kc == KEY_END:
      if vga.get_scroll_offset() > 0:
        vga.scroll_to_bottom()
      g_cursor = g_input_len
      vga.cursor_set(vga.cursor_row(), g_prompt_len + g_cursor)
      continue

    // ── History navigation ──
    if kc == KEY_UP:
      if _hist_prev() != 0: _redraw_input()
      continue

    if kc == KEY_DOWN:
      if _hist_next() != 0: _redraw_input()
      continue

    // ── Tab completion ──
    if kc == KEY_TAB:
      _tab_complete()
      continue

    // ── Escape (clear line) ──
    if kc == KEY_ESC:
      g_input_len = 0
      g_cursor    = 0
      _redraw_input()
      continue

    // ── Printable character ──
    if kc >= 32 && kc <= 126:
      if g_input_len < MAX_INPUT:
        if g_cursor < g_input_len:
          // Insert mode: shift chars right
          i:int = g_input_len
          while i > g_cursor:
            unsafe: g_input[i] = g_input[i - 1]
            i = i - 1
        g_input[g_cursor] = kc
        g_input_len = g_input_len + 1
        g_cursor    = g_cursor + 1
        _redraw_input()
      continue

  ret 0
