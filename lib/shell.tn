  use_mb:int   = pmem.used_mb()
  fre_mb:int   = pmem.free_mb()
  pct:int      = (use_mb * 100) / tot_mb
  if pct == 0 && use_mb > 0: pct = 1

  ms:int    = pit.uptime_ms()
  sec:int   = ms / 1000
  mins:int  = sec / 60
  hrs:int   = mins / 60

  vga.print("\n")

  // ASCII art TezzOS logo (left column) + system info (right column)
