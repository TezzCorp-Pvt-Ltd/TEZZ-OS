// ─── Constants ──────────────────────────────────────────────────

let SHELL_PROMPT:str       = "tezz> "
let SHELL_PROMPT_COLOR_FG:int = 10  // COLOR_LIGHT_GREEN
let SHELL_PROMPT_COLOR_BG:int = 0   // COLOR_BLACK

let MAX_INPUT:int   = 256
let MAX_ARGS:int    = 32
let MAX_HIST:int    = 50
let MAX_ARG_LEN:int = 64

// ─── State ──────────────────────────────────────────────────────

static let g_input:[int;257]       // current input buffer (char codes)
static let g_input_len:int = 0     // number of chars in buffer
static let g_cursor:int    = 0     // cursor position in buffer
static let g_insert_mode:int = 0   // 0 = insert, 1 = overwrite

// History ring buffer
static let g_hist_lines:[str;50]
static let g_hist_count:int = 0
static let g_hist_idx:int   = 0    // browsing index (−1 = current input)

// Temp buffer for history recall
static let g_hist_save:[int;257]
static let g_hist_save_len:int = 0

// Screen output row tracking (for mouse scroll)
static let g_output_start_row:int = 0

// User & Permissions
static let g_current_uid:int  = 1000     // 1000 = normal user, 0 = root
static let g_current_user:str = "user"   // "user" or "root"

// Current theme
static let g_fg:int = 7  // COLOR_LIGHT_GREY
static let g_bg:int = 0  // COLOR_BLACK
static let g_hexview_buf:[char;512]

// ─── String helpers ──────────────────────────────────────────────

fn _str_eq(a:str, b:str) -> int:
  pa:*char = a as *char
  pb:*char = b as *char
  i:int = 0
  unsafe:
    while pa[i] != 0 as char && pb[i] != 0 as char:
      if pa[i] != pb[i]: ret 0
      i = i + 1
    ret (pa[i] == pb[i])
  ret 0

fn _str_len(s:str) -> int:
  p:*char = s as *char
  n:int = 0
  unsafe: while p[n] != 0 as char: n = n + 1
  ret n

fn _str_starts(s:str, prefix:str) -> int:
  ps:*char    = s as *char
  pp:*char    = prefix as *char
  i:int = 0
  unsafe:
    while pp[i] != 0 as char:
      if ps[i] != pp[i]: ret 0
      i = i + 1
  ret 1

// Convert input buffer (int array) to a simple str view
// We use a static staging buffer for this
static let g_stage_buf:[char;257]

fn _buf_to_str(buf:*int, len:int) -> str:
  i:int = 0
  while i < len:
    unsafe: g_stage_buf[i] = buf[i] as char
    i = i + 1
  unsafe:
    g_stage_buf[len] = 0 as char
    ret (&g_stage_buf[0]) as str

// ─── History ────────────────────────────────────────────────────

fn _hist_push(line:str) -> int:
  if _str_len(line) == 0: ret 0
  // Avoid duplicate of last entry
  if g_hist_count > 0:
    last:int = (g_hist_count - 1) % MAX_HIST
    unsafe:
      if _str_eq(g_hist_lines[last], line) != 0: ret 0
  idx:int = g_hist_count % MAX_HIST
  unsafe: g_hist_lines[idx] = line
  g_hist_count = g_hist_count + 1
  g_hist_idx   = g_hist_count  // reset browsing to after last
  ret 0

fn _hist_prev() -> int:
  if g_hist_idx <= 0: ret 0
  if g_hist_idx == g_hist_count:
    // Save current input
    i:int = 0
    while i < g_input_len:
      unsafe: g_hist_save[i] = g_input[i]
      i = i + 1
    g_hist_save_len = g_input_len
  g_hist_idx = g_hist_idx - 1
  if g_hist_idx < 0: g_hist_idx = 0
  // Load history line into input buffer
  idx:int = g_hist_idx % MAX_HIST
  line:str = ""
  unsafe: line = g_hist_lines[idx]
  p:*char = line as *char
  g_input_len = 0
  unsafe:
    while p[g_input_len] != 0 as char:
      g_input[g_input_len] = p[g_input_len] as int
      g_input_len = g_input_len + 1
  g_cursor = g_input_len
  ret 1

fn _hist_next() -> int:
  if g_hist_idx >= g_hist_count: ret 0
  g_hist_idx = g_hist_idx + 1
  if g_hist_idx == g_hist_count:
    // Restore saved input
    i:int = 0
    while i < g_hist_save_len:
      unsafe: g_input[i] = g_hist_save[i]
      i = i + 1
    g_input_len = g_hist_save_len
    g_cursor    = g_input_len
  else:
    idx:int = g_hist_idx % MAX_HIST
    line:str = ""
    unsafe: line = g_hist_lines[idx]
    p:*char = line as *char
    g_input_len = 0
    unsafe:
      while p[g_input_len] != 0 as char:
        g_input[g_input_len] = p[g_input_len] as int
        g_input_len = g_input_len + 1
    g_cursor = g_input_len
  ret 1

// ─── Prompt rendering ───────────────────────────────────────────

static let g_prompt_len:int = 6

fn _redraw_input() -> int:
  // Move to start of input row, after prompt
  row:int = vga.cursor_row()
  // Clear the line from prompt onwards
  col:int = g_prompt_len
  max_c:int = vga.cols()
  while col < max_c:
    vga.putc_at(row, col, 32, vga.make_attr(g_fg, g_bg))
    col = col + 1
  // Reprint the buffer
  i:int = 0
  while i < g_input_len:
    unsafe: vga.putc_at(row, g_prompt_len + i, g_input[i], vga.make_attr(g_fg, g_bg))
    i = i + 1
  // Position VGA cursor
  vga.cursor_set(row, g_prompt_len + g_cursor)
  ret 0

fn _print_prompt() -> int:
  vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
  vga.print("tezz:")
  cwd:str = vfs.vfs_get_cwd_path()
  vga.set_color(COLOR_YELLOW, COLOR_BLACK)
  vga.print(cwd)
  if g_current_uid == 0:
    vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
    vga.print("# ")
  else:
    vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
    vga.print("$ ")
  vga.set_color(g_fg, g_bg)
  g_prompt_len = 5 + _str_len(cwd) + 2
  vga.cursor_set(vga.cursor_row(), g_prompt_len + g_cursor)
  ret 0

fn _get_command_name(idx:int) -> str:
  if idx == 0: ret "help"
  if idx == 1: ret "clear"
  if idx == 2: ret "echo"
  if idx == 3: ret "version"
  if idx == 4: ret "mem"
  if idx == 5: ret "uptime"
  if idx == 6: ret "reboot"
  if idx == 7: ret "shutdown"
  if idx == 8: ret "proc"
  if idx == 9: ret "cpuid"
  if idx == 10: ret "color"
  if idx == 11: ret "history"
  if idx == 12: ret "neofetch"
  if idx == 13: ret "date"
  if idx == 14: ret "fonts"
  if idx == 15: ret "scale"
  if idx == 16: ret "ls"
  if idx == 17: ret "cat"
  if idx == 18: ret "cd"
  if idx == 19: ret "pwd"
  if idx == 20: ret "touch"
  if idx == 21: ret "mkdir"
  if idx == 22: ret "rm"
  if idx == 23: ret "write"
  if idx == 24: ret "stat"
  if idx == 25: ret "df"
  if idx == 26: ret "exit"
  if idx == 27: ret "super"
  if idx == 28: ret "whoami"
  if idx == 29: ret "id"
  if idx == 30: ret "tezz"
  if idx == 31: ret "edit"
  if idx == 32: ret "cp"
  if idx == 33: ret "mv"
  if idx == 34: ret "calc"
  if idx == 35: ret "cowsay"
  if idx == 36: ret "matrix"
  if idx == 37: ret "mouse"
  if idx == 38: ret "lscpu"
  if idx == 39: ret "cpuinfo"
  if idx == 40: ret "free"
  if idx == 41: ret "lspci"
  if idx == 42: ret "lsblk"
  if idx == 43: ret "storage"
  if idx == 44: ret "gpuinfo"
  if idx == 45: ret "wifi"
  if idx == 46: ret "bt"
  if idx == 47: ret "bluetooth"
  if idx == 48: ret "hwinfo"
  if idx == 49: ret "hexview"
  ret ""

fn _tab_complete() -> int:
  if g_input_len == 0: ret 0
  partial:str = _buf_to_str(&g_input[0], g_input_len)
  matches:[str;40]
  n_matches:int = 0
  i:int = 0
  while i < 50:
    cmd_name:str = _get_command_name(i)
    if _str_starts(cmd_name, partial) != 0:
      matches[n_matches] = cmd_name
      n_matches = n_matches + 1
    i = i + 1
  if n_matches == 0: ret 0
  if n_matches == 1:
    // Complete the word
    unsafe:
      completed:str = matches[0]
      p:*char = completed as *char
      g_input_len = 0
      while p[g_input_len] != 0 as char:
        g_input[g_input_len] = p[g_input_len] as int
        g_input_len = g_input_len + 1
    // Add space
    g_input[g_input_len] = 32
    g_input_len = g_input_len + 1
    g_cursor = g_input_len
    _redraw_input()
  else:
    // Show all matches on a new line
    vga.print("\n")
    j:int = 0
    while j < n_matches:
      unsafe: vga.print(matches[j])
      vga.print("  ")
      j = j + 1
    vga.print("\n")
    _print_prompt()
    _redraw_input()
  ret 0

