fn _cmd_version() -> int:
  vga.print("\n")
  vga.set_color(COLOR_LIGHT_CYAN, COLOR_BLACK)
  vga.print("  TEZZ-OS")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print(" version ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print("0.1.0")
  vga.set_color(COLOR_YELLOW, COLOR_BLACK)
  vga.print(" \"Nova\"\n")
  vga.set_color(g_fg, g_bg)
  vga.print("  Architecture : x86_64\n")
  vga.print("  Built with   : TezzNative 1.1.0\n")
  vga.print("  Kernel       : TezzOS Kernel v0.1.0\n")
  vga.print("  Boot         : Limine Bootloader\n")
  vga.print("\n")
  ret 0

fn _cmd_mem() -> int:
  free_mb:int  = pmem.free_mb()
  total_mb:int = pmem.total_mb()
  used_mb:int  = total_mb - free_mb
  pct:int = 0
  if total_mb > 0: pct = (used_mb * 100) / total_mb

  vga.print("\nMemory Usage:\n")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print("  Total  : ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(total_mb)
  vga.set_color(g_fg, g_bg)
  vga.print(" MB\n")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print("  Used   : ")
  vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
  vga.print_int(used_mb)
  vga.set_color(g_fg, g_bg)
  vga.print(" MB (")
  vga.print_int(pct)
  vga.print("%)\n")
  vga.set_color(COLOR_WHITE, COLOR_BLACK)
  vga.print("  Free   : ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(free_mb)
  vga.set_color(g_fg, g_bg)
  vga.print(" MB\n")

  // ASCII bar
  vga.print("  [")
  vga.set_color(COLOR_LIGHT_RED, COLOR_BLACK)
  bar_used:int = pct * 40 / 100
  i:int = 0
  while i < bar_used:
    vga.putc(9608)   // █
    i = i + 1
  vga.set_color(COLOR_DARK_GREY, COLOR_BLACK)
  while i < 40:
    vga.putc(9617)   // ░
    i = i + 1
  vga.set_color(g_fg, g_bg)
  vga.print("]\n\n")
  ret 0

fn _cmd_uptime() -> int:
  ms:int = pit.uptime_ms()
  sec:int  = ms / 1000
  mins:int = sec / 60
  hrs:int  = mins / 60
  sec  = sec % 60
  mins = mins % 60
  vga.print("\nUptime: ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(hrs)
  vga.set_color(g_fg, g_bg)
  vga.print("h ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(mins)
  vga.set_color(g_fg, g_bg)
  vga.print("m ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print_int(sec)
  vga.set_color(g_fg, g_bg)
  vga.print("s\n\n")
  ret 0

fn cpuid_vendor() -> str:
  ret "GenuineIntel/AuthenticAMD (x86_64)"

fn _cmd_cpuid() -> int:
  vendor:str = cpuid_vendor()
  vga.print("\nCPU Vendor : ")
  vga.set_color(COLOR_LIGHT_GREEN, COLOR_BLACK)
  vga.print(vendor)
  vga.set_color(g_fg, g_bg)
  vga.print("\nArchitecture : x86_64\n")
  vga.print("Mode         : 64-bit protected\n\n")
  ret 0

fn _cmd_history() -> int:
  vga.print("\n")
  n:int = g_hist_count
  if n > MAX_HIST: n = MAX_HIST
  if n == 0:
    vga.print("  (no history)\n\n")
    ret 0
  start:int = g_hist_count - n
  i:int = 0
  while i < n:
    idx:int = (start + i) % MAX_HIST
    vga.set_color(COLOR_DARK_GREY, COLOR_BLACK)
    vga.print_int(start + i + 1)
    vga.print("  ")
    vga.set_color(g_fg, g_bg)
    unsafe: vga.print(g_hist_lines[idx])
    vga.print("\n")
    i = i + 1
  vga.print("\n")
  ret 0

fn _cmd_color(scheme:int) -> int:
  if scheme == 0:
    g_fg = COLOR_LIGHT_GREY
    g_bg = COLOR_BLACK
    vga.print("Color: default\n")
  else if scheme == 1:
    g_fg = COLOR_LIGHT_GREEN
    g_bg = COLOR_BLACK
    vga.print("Color: matrix (green on black)\n")
  else if scheme == 2:
    g_fg = COLOR_YELLOW
    g_bg = COLOR_BLACK
    vga.print("Color: amber (yellow on black)\n")
  else if scheme == 3:
    g_fg = COLOR_LIGHT_CYAN
    g_bg = COLOR_BLACK
    vga.print("Color: blue (cyan on black)\n")
  else if scheme == 4:
    g_fg = COLOR_WHITE
    g_bg = COLOR_BLUE
    vga.print("Color: classic (white on blue)\n")
  else:
    vga.print("Usage: color [0-4]\n  0=default 1=matrix 2=amber 3=cyan 4=classic\n")
  vga.set_color(g_fg, g_bg)
  ret 0

fn _cmd_neofetch() -> int:
