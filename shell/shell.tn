// ═══════════════════════════════════════════════════════════════
// TEZZ-OS — Interactive CLI Shell (shell/shell.tn)
// ═══════════════════════════════════════════════════════════════
//
//  Full-featured CLI shell for TEZZ-OS:
//   - Input line editor: left/right arrows, Home/End, Insert
//   - Command history (50 entries, up/down arrows)
//   - Tab completion for built-in commands
//   - Ctrl+C (cancel line), Ctrl+L (clear), Ctrl+D (shutdown)
//   - Mouse: click to position cursor in the input line
//   - Mouse scroll wheel: scroll history output
//   - Built-in commands:
//       help     — list commands
//       clear    — clear screen
//       echo     — print arguments
//       version  — OS version info
//       mem      — memory statistics
//       uptime   — system uptime
//       reboot   — reboot system
//       shutdown — power off system
//       proc     — list processes (stub)
//       cpuid    — CPU vendor string
//       color    — change console color scheme
//       history  — show command history
//       neofetch — system info display (ASCII art style)
// ═══════════════════════════════════════════════════════════════

import "../drivers/vga"
import "../drivers/keyboard"
import "../drivers/mouse"
import "sys"
import "../kernel/pmem"
import "../kernel/pit"

// ─── Constants ──────────────────────────────────────────────────

let SHELL_PROMPT:str       = "tezz> "
let SHELL_PROMPT_COLOR_FG:int = vga.COLOR_LIGHT_GREEN
let SHELL_PROMPT_COLOR_BG:int = vga.COLOR_BLACK

let MAX_INPUT:int   = 256
let MAX_ARGS:int    = 32
let MAX_HIST:int    = 50
let MAX_ARG_LEN:int = 64

// ─── State ──────────────────────────────────────────────────────

static let g_input:[int;257]       // current input buffer (char codes)
static let g_input_len:int = 0     // number of chars in buffer
static let g_cursor:int    = 0     // cursor position in buffer
static let g_insert_mode:int = 0   // 0 = insert, 1 = overwrite

// History ring buffer
static let g_hist_lines:[str;50]
static let g_hist_count:int = 0
static let g_hist_idx:int   = 0    // browsing index (−1 = current input)

// Temp buffer for history recall
static let g_hist_save:[int;257]
static let g_hist_save_len:int = 0

// Screen output row tracking (for mouse scroll)
static let g_output_start_row:int = 0

// Current theme
static let g_fg:int = vga.COLOR_LIGHT_GREY
static let g_bg:int = vga.COLOR_BLACK

// ─── String helpers ──────────────────────────────────────────────

fn _str_eq(a:str, b:str) -> int:
  pa:*char = a as *char
  pb:*char = b as *char
  i:int = 0
  unsafe:
    while pa[i] != 0 as char && pb[i] != 0 as char:
      if pa[i] != pb[i]: ret 0
      i = i + 1
    ret (pa[i] == pb[i])
  ret 0

fn _str_len(s:str) -> int:
  p:*char = s as *char
  n:int = 0
  unsafe: while p[n] != 0 as char: n = n + 1
  ret n

fn _str_starts(s:str, prefix:str) -> int:
  ps:*char    = s as *char
  pp:*char    = prefix as *char
  i:int = 0
  unsafe:
    while pp[i] != 0 as char:
      if ps[i] != pp[i]: ret 0
      i = i + 1
  ret 1

// Convert input buffer (int array) to a simple str view
// We use a static staging buffer for this
static let g_stage_buf:[char;257]

fn _buf_to_str(buf:*int, len:int) -> str:
  i:int = 0
  while i < len:
    unsafe: g_stage_buf[i] = buf[i] as char
    i = i + 1
  unsafe: g_stage_buf[len] = 0 as char
  ret g_stage_buf as str

// ─── History ────────────────────────────────────────────────────

fn _hist_push(line:str) -> int:
  if _str_len(line) == 0: ret 0
  // Avoid duplicate of last entry
  if g_hist_count > 0:
    last:int = (g_hist_count - 1) % MAX_HIST
    unsafe:
      if _str_eq(g_hist_lines[last], line) != 0: ret 0
  idx:int = g_hist_count % MAX_HIST
  unsafe: g_hist_lines[idx] = line
  g_hist_count = g_hist_count + 1
  g_hist_idx   = g_hist_count  // reset browsing to after last
  ret 0

fn _hist_prev() -> int:
  if g_hist_idx <= 0: ret 0
  if g_hist_idx == g_hist_count:
    // Save current input
    i:int = 0
    while i < g_input_len:
      unsafe: g_hist_save[i] = g_input[i]
      i = i + 1
    g_hist_save_len = g_input_len
  g_hist_idx = g_hist_idx - 1
  if g_hist_idx < 0: g_hist_idx = 0
  // Load history line into input buffer
  idx:int = g_hist_idx % MAX_HIST
  line:str = 0
  unsafe: line = g_hist_lines[idx]
  p:*char = line as *char
  g_input_len = 0
  unsafe:
    while p[g_input_len] != 0 as char:
      g_input[g_input_len] = p[g_input_len] as int
      g_input_len = g_input_len + 1
  g_cursor = g_input_len
  ret 1

fn _hist_next() -> int:
  if g_hist_idx >= g_hist_count: ret 0
  g_hist_idx = g_hist_idx + 1
  if g_hist_idx == g_hist_count:
    // Restore saved input
    i:int = 0
    while i < g_hist_save_len:
      unsafe: g_input[i] = g_hist_save[i]
      i = i + 1
    g_input_len = g_hist_save_len
    g_cursor    = g_input_len
  else:
    idx:int = g_hist_idx % MAX_HIST
    line:str = 0
    unsafe: line = g_hist_lines[idx]
    p:*char = line as *char
    g_input_len = 0
    unsafe:
      while p[g_input_len] != 0 as char:
        g_input[g_input_len] = p[g_input_len] as int
        g_input_len = g_input_len + 1
    g_cursor = g_input_len
  ret 1

// ─── Prompt rendering ───────────────────────────────────────────

let PROMPT_LEN:int = 6   // len("tezz> ")

fn _redraw_input() -> int:
  // Move to start of input row, after prompt
  row:int = vga.cursor_row()
  // Clear the line from prompt onwards
  col:int = PROMPT_LEN
  while col < 80:
    vga.putc_at(row, col, 32, vga.make_attr(g_fg, g_bg))
    col = col + 1
  // Reprint the buffer
  i:int = 0
  while i < g_input_len:
    unsafe: vga.putc_at(row, PROMPT_LEN + i, g_input[i], vga.make_attr(g_fg, g_bg))
    i = i + 1
  // Position VGA cursor
  vga.cursor_set(row, PROMPT_LEN + g_cursor)
  ret 0

fn _print_prompt() -> int:
  vga.set_color(SHELL_PROMPT_COLOR_FG, SHELL_PROMPT_COLOR_BG)
  vga.print(SHELL_PROMPT)
  vga.set_color(g_fg, g_bg)
  ret 0

fn _get_command_name(idx:int) -> str:
  if idx == 0: ret "help"
  if idx == 1: ret "clear"
  if idx == 2: ret "echo"
  if idx == 3: ret "version"
  if idx == 4: ret "mem"
  if idx == 5: ret "uptime"
  if idx == 6: ret "reboot"
  if idx == 7: ret "shutdown"
  if idx == 8: ret "proc"
  if idx == 9: ret "cpuid"
  if idx == 10: ret "color"
  if idx == 11: ret "history"
  if idx == 12: ret "neofetch"
  if idx == 13: ret "date"
  if idx == 14: ret "env"
  if idx == 15: ret "exit"
  ret ""

fn _tab_complete() -> int:
  if g_input_len == 0: ret 0
  partial:str = _buf_to_str(&g_input[0], g_input_len)
  matches:[str;16]
  n_matches:int = 0
  i:int = 0
  while i < 16:
    cmd_name:str = _get_command_name(i)
    if _str_starts(cmd_name, partial) != 0:
      matches[n_matches] = cmd_name
      n_matches = n_matches + 1
    i = i + 1
  if n_matches == 0: ret 0
  if n_matches == 1:
    // Complete the word
    unsafe:
      completed:str = matches[0]
      p:*char = completed as *char
      g_input_len = 0
      while p[g_input_len] != 0 as char:
        g_input[g_input_len] = p[g_input_len] as int
        g_input_len = g_input_len + 1
    // Add space
    g_input[g_input_len] = 32
    g_input_len = g_input_len + 1
    g_cursor = g_input_len
    _redraw_input()
  else:
    // Show all matches on a new line
    vga.print("\n")
    j:int = 0
    while j < n_matches:
      unsafe: vga.print(matches[j])
      vga.print("  ")
      j = j + 1
    vga.print("\n")
    _print_prompt()
    _redraw_input()
  ret 0

// ─── Built-in command implementations ───────────────────────────

