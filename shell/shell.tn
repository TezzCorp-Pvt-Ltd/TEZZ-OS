  vga.set_color(g_fg, g_bg)
  vga.print("Clear the screen\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  echo [text] ")
  vga.set_color(g_fg, g_bg)
  vga.print("Print text to screen\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  version     ")
  vga.set_color(g_fg, g_bg)
  vga.print("Show OS version\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  mem         ")
  vga.set_color(g_fg, g_bg)
  vga.print("Memory statistics\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  uptime      ")
  vga.set_color(g_fg, g_bg)
  vga.print("System uptime\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  cpuid       ")
  vga.set_color(g_fg, g_bg)
  vga.print("CPU vendor and features\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  proc        ")
  vga.set_color(g_fg, g_bg)
  vga.print("List processes\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  color [N]   ")
  vga.set_color(g_fg, g_bg)
  vga.print("Change color scheme (0=default, 1=matrix, 2=amber, 3=blue)\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  history     ")
  vga.set_color(g_fg, g_bg)
  vga.print("Show command history\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  neofetch    ")
  vga.set_color(g_fg, g_bg)
  vga.print("System information display\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  reboot      ")
  vga.set_color(g_fg, g_bg)
  vga.print("Restart the system\n")
  vga.set_color(vga.COLOR_WHITE, vga.COLOR_BLACK)
  vga.print("  shutdown    ")
  vga.set_color(g_fg, g_bg)
  vga.print("Power off the system\n")
  vga.set_color(vga.COLOR_LIGHT_CYAN, vga.COLOR_BLACK)
  vga.print("\nKeyboard Shortcuts:\n")
  vga.set_color(g_fg, g_bg)
